# ========================================
# AutoShorts - Environment Variables
# ========================================

# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Upload & Storage Configuration
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# AWS S3 / Cloudflare R2 Configuration
# Use R2 for free storage (no egress fees)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_BUCKET_NAME=autoshorts

# Or use Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autoshorts
R2_REGION=auto

# OpenAI Configuration (for AI analysis)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AssemblyAI Configuration (for captions/transcription)
# Get your key from https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# YouTube Configuration
# Get your key from https://console.cloud.google.com/
YOUTUBE_API_KEY=

# YouTube Transcript API (optional)
# Get your key from https://youtubetranscript.dev/
YOUTUBE_TRANSCRIPT_API_KEY=

# FFmpeg Configuration (optional)
# FFmpeg_PATH=/usr/local/bin/ffmpeg

# Redis Configuration (optional, for queue)
# REDIS_URL=redis://localhost:6379
